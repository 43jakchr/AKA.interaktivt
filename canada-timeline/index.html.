<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Territorial Evolution of Canada — Interactive Timeline</title><style>
:root{font-family:Roboto,Arial,sans-serif;color:#20252a;color-scheme:light}*{box-sizing:border-box}body{margin:0;background:#fff}.wrap{width:100%;max-width:840px;margin:auto;padding:16px}.head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 12px;flex-wrap:wrap}h1{font-size:clamp(20px,3.3vw,28px);line-height:1.2;margin:0;font-weight:700}.tag{color:#347d76;background:#eaf3f1;padding:7px 12px;border-radius:20px;font-size:13px;font-weight:700}.map{display:block;width:100%;height:auto;border-radius:12px;border:1px solid #dbe3e1}.controls{margin-top:15px;background:#f5f8f7;border:1px solid #e2e8e6;border-radius:12px;padding:14px 16px}.top{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:12px}.top strong{font-size:16px}.count{font-size:13px;color:#53615b}input[type=range]{width:100%;accent-color:#347d76;cursor:pointer;touch-action:pan-y} .bounds{display:flex;justify-content:space-between;font-size:12px;color:#62706a;margin-top:4px}.btns{display:flex;justify-content:space-between;gap:10px;margin-top:15px}button{border:1px solid #347d76;background:#fff;color:#347d76;padding:10px 16px;border-radius:8px;min-height:44px;font:600 14px Roboto,Arial,sans-serif;cursor:pointer}button:hover:not(:disabled){background:#eaf3f1}button:disabled{opacity:.4;cursor:not-allowed}button:focus-visible,input:focus-visible{outline:3px solid #f08920;outline-offset:2px}.credit{font-size:12px;color:#606b66;margin:12px 2px;line-height:1.5}.credit a{color:#27645f}@media(max-width:480px){.wrap{padding:9px}.controls{padding:12px}.btns button{flex:1}}
</style></head><body><main class="wrap"><div class="head"><h1>Territorial Evolution of Canada</h1><span class="tag">Interactive timeline</span></div><img id="map" class="map" alt="Historical map of Canadian provinces and territories, first frame, July 1 1867" width="1000" height="864"><section class="controls" aria-label="Map timeline"><div class="top"><strong>Explore the historical changes</strong><span class="count" id="count" aria-live="polite">Map 1 of 20</span></div><label for="timeline" style="display:block;font-size:13px;margin-bottom:7px">Drag the slider to change the map:</label><input id="timeline" type="range" min="0" max="19" step="1" value="0" aria-label="Historical map frame"><div class="bounds"><span>1867</span><span>2003</span></div><div class="btns"><button id="prev" type="button" disabled>← Previous</button><button id="next" type="button">Next →</button></div></section><p class="credit">Based on <a href="https://commons.wikimedia.org/wiki/File:Canada_provinces_evolution_2.gif" target="_blank" rel="noopener noreferrer">Canada provinces evolution 2</a> on Wikimedia Commons. The original date and event descriptions are preserved within each map.</p></main><script>
const frames=["data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,"];
const slider=document.getElementById('timeline'),map=document.getElementById('map'),count=document.getElementById('count'),prev=document.getElementById('prev'),next=document.getElementById('next');
function render(n){n=Math.max(0,Math.min(frames.length-1,Number(n)));slider.value=n;map.src=frames[n];map.alt='Historical map of the evolution of Canada, frame '+(n+1)+' of '+frames.length+'. Date and event description are shown within the map image.';count.textContent='Map '+(n+1)+' of '+frames.length;prev.disabled=n===0;next.disabled=n===frames.length-1;}
slider.addEventListener('input',e=>render(e.target.value));prev.addEventListener('click',()=>render(+slider.value-1));next.addEventListener('click',()=>render(+slider.value+1));document.addEventListener('keydown',e=>{if(e.target===slider)return;if(e.key==='ArrowLeft')render(+slider.value-1);if(e.key==='ArrowRight')render(+slider.value+1)});render(0);
</script></body></html>
